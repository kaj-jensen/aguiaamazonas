---
interface Props {
  lang?: 'en' | 'pt-BR';
}

const { lang = 'en' } = Astro.props;
const isPt = lang === 'pt-BR';
const instagramUrl = 'https://www.instagram.com/aguiaamazonastur/';
const photos = [
  {
    src: '/images/gallery/jardim-maravilha/river-journey.webp',
    alt: isPt ? 'Viagem de canoa por um igarapé amazônico' : 'Canoe journey through an Amazon waterway',
  },
  {
    src: '/images/gallery/full-day/guided-jungle-walk.jpg',
    alt: isPt ? 'Antonio compartilhando conhecimentos durante uma caminhada na floresta' : 'Antonio sharing forest knowledge during a jungle walk',
  },
  {
    src: '/images/gallery/jardim-maravilha/night-caiman.webp',
    alt: isPt ? 'Observação noturna da fauna amazônica com Antonio' : 'Night-time Amazon wildlife observation with Antonio',
  },
];
---

<section class="instagram-showcase" aria-labelledby="instagram-title">
  <div class="instagram-heading wrap">
    <div>
      <p class="eyebrow">{isPt ? 'Direto da Amazônia' : 'From the Amazon'}</p>
      <h2 id="instagram-title">{isPt ? 'Acompanhe a jornada.' : 'Follow the journey.'}</h2>
    </div>
    <div class="instagram-intro">
      <p>{isPt ? 'Veja novos encontros, paisagens e momentos das viagens de Antonio pela floresta.' : 'See new encounters, landscapes and moments from Antonio’s journeys through the rainforest.'}</p>
      <a href={instagramUrl} target="_blank" rel="noreferrer" aria-label={isPt ? 'Seguir @aguiaamazonastur no Instagram' : 'Follow @aguiaamazonastur on Instagram'}>
        <svg aria-hidden="true" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle class="instagram-dot" cx="17.4" cy="6.6" r="1"></circle></svg>
        <span><small>Instagram</small><strong>@aguiaamazonastur</strong></span>
        <b aria-hidden="true">↗</b>
      </a>
    </div>
  </div>

  <div class="instagram-grid wrap">
    {photos.map((photo) => (
      <a href={instagramUrl} target="_blank" rel="noreferrer" aria-label={isPt ? 'Ver o Instagram da Águia Amazonas' : 'View Águia Amazonas on Instagram'}>
        <img src={photo.src} alt={photo.alt} loading="lazy" decoding="async" />
        <span aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle class="instagram-dot" cx="17.4" cy="6.6" r="1"></circle></svg></span>
      </a>
    ))}
  </div>
</section>

<style>
  .instagram-showcase{padding:82px 0 90px;background:#f4eee7}
  .instagram-heading{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(300px,.9fr);gap:70px;align-items:end;margin-bottom:34px}
  .instagram-heading h2{margin:0;font-family:var(--display);font-size:clamp(46px,5vw,76px);line-height:1;letter-spacing:-.04em}
  .instagram-intro>p{margin:0 0 20px;color:#596760;font-size:17px}
  .instagram-intro>a{display:flex;align-items:center;gap:13px;width:max-content;max-width:100%;padding:11px 16px 11px 12px;border:1px solid #c9bdb4;border-radius:999px;background:#fff;box-shadow:0 10px 30px rgba(34,27,24,.08);transition:transform .2s ease,box-shadow .2s ease}
  .instagram-intro>a:hover{transform:translateY(-2px);box-shadow:0 15px 34px rgba(34,27,24,.13)}
  .instagram-intro svg,.instagram-grid span svg{width:28px;height:28px;fill:none;stroke:currentColor;stroke-width:1.7}
  .instagram-intro>a>svg{padding:5px;border-radius:50%;box-sizing:content-box;color:#fff;background:linear-gradient(135deg,#7446a8,#d62f79 52%,#ef7a3d)}
  .instagram-dot{fill:currentColor;stroke:none}
  .instagram-intro span{display:flex;flex-direction:column;line-height:1.2}
  .instagram-intro small{color:#7a6d66;font-size:9px;text-transform:uppercase;letter-spacing:.16em}
  .instagram-intro strong{font-size:14px}
  .instagram-intro b{margin-left:4px;color:#c32c72;font-size:19px}
  .instagram-grid{display:grid;grid-template-columns:1.15fr .85fr 1fr;gap:15px}
  .instagram-grid>a{position:relative;min-height:370px;overflow:hidden;background:#d9d1c9}
  .instagram-grid img{width:100%;height:100%;object-fit:cover;transition:transform .55s ease,filter .35s ease}
  .instagram-grid>a:hover img{transform:scale(1.035);filter:brightness(.82)}
  .instagram-grid span{position:absolute;right:16px;top:16px;display:grid;place-items:center;width:43px;height:43px;border-radius:50%;color:#fff;background:rgba(7,28,22,.7);opacity:0;transform:translateY(-5px);transition:opacity .2s ease,transform .2s ease}
  .instagram-grid>a:hover span{opacity:1;transform:none}
  @media(max-width:900px){.instagram-showcase{padding:60px 0 66px}.instagram-heading{grid-template-columns:1fr;gap:22px}.instagram-grid{grid-template-columns:1fr 1fr}.instagram-grid>a{min-height:320px}.instagram-grid>a:nth-child(2){margin-top:0}.instagram-grid>a:last-child{grid-column:1/-1;min-height:380px}}
  @media(max-width:560px){.instagram-heading h2{font-size:46px}.instagram-intro>a{width:100%}.instagram-intro b{margin-left:auto}.instagram-grid{grid-template-columns:1fr;gap:10px}.instagram-grid>a,.instagram-grid>a:last-child{grid-column:auto;min-height:340px}.instagram-grid span{opacity:1;transform:none}}
  @media(prefers-reduced-motion:reduce){.instagram-intro>a,.instagram-grid img,.instagram-grid span{transition:none}}
</style>
